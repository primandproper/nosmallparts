{
  "name": "@nsp/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/expo": "^1.1.4",
    "@hono/node-server": "^1.13.7",
    "@hono/node-ws": "^1.0.5",
    "@nsp/shared": "workspace:*",
    "better-auth": "^1.1.4",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.6.13",
    "livekit-server-sdk": "^2.9.1",
    "ulid": "^2.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
