# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars.
# Single environment: prod.
#
# Terraform Cloud: set the same variable names in the workspace Variables tab
# (e.g. project_id, google_cloud_credentials, cloudflare_api_token, sendgrid_api_token,
# segment_api_token, posthog_api_key, posthog_personal_api_key,
# google_sso_oauth2_client_id, google_sso_oauth2_client_secret,
# frontend_oauth2_client_id, frontend_oauth2_client_secret). Mark secrets as Sensitive.

environment  = "prod"
project_id   = "no-small-parts-dev"
gcp_region   = "us-central1"
gcp_main_zone = "us-central1-a"

# google_cloud_credentials = "path/to/sa.json"  # or set TF_VAR_google_cloud_credentials

db_instance_name = "prod"

cloudflare_zone_id = "your-zone-id"
# cloudflare_api_token = "..."  # set via env or -var

media_bucket_name   = "media.nosmall.parts"
userdata_bucket_name = "userdata.nosmall.parts"

frontend_backend_http_url = "https://nosmallparts-api-prod-xxxxx.run.app"
frontend_grpc_backend_url = "nosmallparts-api-prod-xxxxx.run.app:443"
frontend_oauth2_client_id = "prodclientid12345"
frontend_oauth2_client_secret = "..."  # sensitive
# frontend_next_public_backend_ws_url = "wss://..."
