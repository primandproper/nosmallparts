# LiveKit configuration (optional - app works without it)
# Get these from your LiveKit Cloud dashboard or self-hosted instance
# Note: The docker-compose maps these to SERVICE_LIVEKIT_* for the backend
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Pusher Channels configuration (for real-time stage updates)
# Get these from your Pusher dashboard at https://dashboard.pusher.com
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
