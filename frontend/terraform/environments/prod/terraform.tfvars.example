# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars.
# Frontend prod – requires backend Terraform applied first.
# Set frontend_backend_http_url and frontend_grpc_backend_url from backend outputs.

environment  = "prod"
project_id   = "no-small-parts"
gcp_region   = "us-central1"
gcp_main_zone = "us-central1-a"

# From backend Terraform: terraform output -raw cloud_run_api_url
frontend_backend_http_url = "https://nosmallparts-api-prod-xxxxx.run.app"
# Backend gRPC host:port (e.g. nosmallparts-api-prod-xxxxx.run.app:443)
frontend_grpc_backend_url = "nosmallparts-api-prod-xxxxx.run.app:443"

# From backend Terraform: terraform output -raw artifact_registry_repository_id
artifact_repository_id = "containers"

# OAuth2 client for frontend (set in TFC as sensitive)
# frontend_oauth2_client_id = "..."
# frontend_oauth2_client_secret = "..."
# frontend_next_public_backend_ws_url = "wss://..."

# AdSense (set in TFC as ADSENSE_PUBLISHER_ID and ADSENSE_SLOT_ID)
# ADSENSE_PUBLISHER_ID = "ca-pub-xxxxxxxxxxxxxxxx"
# ADSENSE_SLOT_ID = "1234567890"
