.PHONY: setup
setup:
	npm install

.PHONY: dev
dev:
	npm run dev

.PHONY: build
build:
	npm run build

.PHONY: start
start:
	npm run start

.PHONY: lint
lint:
	npm run lint

.PHONY: typecheck
typecheck:
	npm run typecheck

.PHONY: test
test:
	npm test

.PHONY: test-watch
test-watch:
	npm run test:watch

.PHONY: test-e2e
test-e2e:
	npm run test:e2e

.PHONY: format
format:
	npm run format

.PHONY: format-check
format-check:
	npm run format:check
