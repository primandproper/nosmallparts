# Copy to .env and fill in values.
# Backend URLs (server-side and public)
# For local dev: backend may be localhost or docker service name (e.g. backend)
BACKEND_HTTP_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000/ws/stages

# OAuth2 client credentials for authenticated API requests.
# Must match an OAuth2 client registered in the backend (e.g. seeded by localdev).
# Localdev default: OAUTH2_CLIENT_ID=AAAAAAAAAAAAAAAA, OAUTH2_CLIENT_SECRET=AAAAAAAAAAAAAAAA
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# 32-byte key (base64 or hex) for encrypting the stored backend session cookie. Required in production.
SESSION_COOKIE_ENCRYPTION_KEY=
