# Copy to .env and fill in values.
# Backend URLs (server-side and public)
# For local dev: backend may be localhost or docker service name (e.g. backend)
GRPC_BACKEND_URL=localhost:8001
BACKEND_HTTP_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000/ws/stages

# OAuth2 client credentials for authenticated gRPC/API requests.
# Must match an OAuth2 client registered in the backend (e.g. seeded by localdev).
# Localdev default: OAUTH2_CLIENT_ID=AAAAAAAAAAAAAAAA, OAUTH2_CLIENT_SECRET=AAAAAAAAAAAAAAAA
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# AdSense (optional). NEXT_PUBLIC_* is required for layout (avoids hydration mismatch).
# For prod Docker builds: pass --build-arg NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=$ADSENSE_PUBLISHER_ID
# NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
# ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
# ADSENSE_SLOT_ID=1234567890
