# gRPC Backend URL for the API server
# This is used by Next.js API routes and the WebSocket handler to connect to the Go gRPC backend
# Copy this file to .env.local and adjust values as needed
GRPC_BACKEND_URL=localhost:8001

# HTTP backend URL (used for OAuth2 token exchange during login)
BACKEND_HTTP_URL=http://localhost:8000

# OAuth2 client credentials (must match a client seeded in the backend, e.g. by localdev)
OAUTH2_CLIENT_ID=AAAAAAAAAAAAAAAA
OAUTH2_CLIENT_SECRET=AAAAAAAAAAAAAAAA
