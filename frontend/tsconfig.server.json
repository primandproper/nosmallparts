{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "noEmit": false,
    "esModuleInterop": true,
    "declaration": false
  },
  "include": ["server.ts", "lib/stages/**/*.ts"],
  "exclude": ["node_modules", ".next", "app", "components", "hooks", "generated"]
}
