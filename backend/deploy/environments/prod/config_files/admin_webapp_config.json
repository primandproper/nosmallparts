{
  "cookies": {
    "domain": "localhost",
    "cookieName": "prod_admin_frontend",
    "base64EncodedHashKey": " ",
    "base64EncodedBlockKey": " ",
    "lifetime": 0,
    "secureOnly": false
  },
  "apiServiceConfig": {
    "httpAPIServerURL": "https://api.nosmall.parts",
    "grpcAPIServerURL": "api.nosmall.parts:443",
    "oauth2APIClientID": "",
    "oauth2APIClientSecret": ""
  },
  "routing": {
    "chiConfig": {
      "serviceName": "no_small_parts",
      "enableCORSForLocalhost": true
    },
    "provider": "chi"
  },
  "encoding": {
    "contentType": "application/json"
  },
  "observability": {
    "logging": {
      "serviceName": "admin_webapp",
      "level": "debug",
      "provider": "slog"
    },
    "metrics": {
      "serviceName": "admin_webapp",
      "provider": ""
    },
    "tracing": {
      "service_name": "admin_webapp",
      "provider": "",
      "spanCollectionProbability": 0
    }
  },
  "meta": {
    "runMode": "development",
    "debug": true
  },
  "server": {
    "startupDeadline": 60000000000,
    "port": 8888,
    "debug": true
  }
}
