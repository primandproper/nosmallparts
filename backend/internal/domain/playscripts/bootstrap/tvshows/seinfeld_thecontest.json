{
  "title": "Seinfeld - The Contest (Excerpt)",
  "description": "The Contest episode from Seinfeld (1992), created by Larry David and Jerry Seinfeld",
  "author": "Larry David, Jerry Seinfeld",
  "isPublic": true,
  "castMembers": [
    { "id": "seinfeld_kramer", "name": "Kramer", "sortOrder": 0 },
    { "id": "seinfeld_jerry", "name": "Jerry", "sortOrder": 1 },
    { "id": "seinfeld_elaine", "name": "Elaine", "sortOrder": 2 },
    { "id": "seinfeld_george", "name": "George", "sortOrder": 3 }
  ],
  "lines": [
    { "castMemberId": "seinfeld_kramer", "lineText": "Hey, Georgie.", "lineIndex": 0, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Hi.", "lineIndex": 1, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Hi.", "lineIndex": 2, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "What's the matter?", "direction": "to George", "lineIndex": 3, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "My mother caught me.", "direction": "slowly shakes his head", "lineIndex": 4, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "\"Caught\" you? Doing what?", "lineIndex": 5, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "You know. I was alone..", "lineIndex": 6, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "You mean..?!", "direction": "making a face of surprise", "lineIndex": 7, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Uh-huh.", "direction": "nods", "lineIndex": 8, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_kramer", "lineText": "She caught you?", "direction": "laughing", "lineIndex": 9, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Where?", "lineIndex": 10, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "..I stopped by the house to drop the car off, and I went inside for a few minutes.. Nobody was there - they're supposed to be working. My mother had a Glamour magazine, I started leafing through it..", "direction": "not really wanting to embellish", "lineIndex": 11, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "\"Glamour\"?", "lineIndex": 12, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "..So, one thing lead to another..", "lineIndex": 13, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "So, what did she do?", "lineIndex": 14, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "First she screams, \"George, what are you doing?! My God!\" And it looked like she was gonna faint - she started clutching the wall, trying to hang onto it.", "lineIndex": 15, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_kramer", "lineText": "Man..", "direction": "reflecting on the story so far", "lineIndex": 16, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "I didn't know whether to try and keep her from falling, or zip up.", "lineIndex": 17, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "What did you do?", "lineIndex": 18, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "I zipped up!", "lineIndex": 19, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "So, she fell?", "direction": "wide-eyed", "lineIndex": 20, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Yeah. Well, I couldn't run over there the way I was!", "direction": "noticing this makes him out to be the bad kid, he gets defensive", "lineIndex": 21, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "No, I guess you couldn't have..", "lineIndex": 22, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "No, I wouldn't think so.", "direction": "in the middle of Elaine's sentence, smiling", "lineIndex": 23, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "..done that.", "direction": "finishing it off", "lineIndex": 24, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "So, she fell, and then she started screaming, \"My back! My back!\" So, I picked her up and took her to the hospital.", "lineIndex": 25, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "How is she?", "direction": "between chuckles", "lineIndex": 26, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "She's in traction.", "direction": "somewhat angered", "lineIndex": 27, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Ok, I'm sorry.", "direction": "still laughing", "lineIndex": 28, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "It's not funny, Elaine.", "lineIndex": 29, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "I know. I'm sorry. I'm serious.", "direction": "stifling her laughter", "lineIndex": 30, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Her back went out. She's gotta be there for a couple of days. All she said on the way over in the car was, \"Why, George, why?!\".. I said, \"Because it's there!\"", "lineIndex": 31, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "\"Glamour\"?", "lineIndex": 32, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Well, I'll tell you this, though - I am never doing.. that , again.", "direction": "vowing", "lineIndex": 33, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "What, you mean, in your mother's house, or all together?", "lineIndex": 34, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "All together.", "direction": "definite", "lineIndex": 35, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Oh, gimme a break..", "lineIndex": 36, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Ohhh yeah.. right.", "direction": "skeptical", "lineIndex": 37, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_kramer", "lineText": "Oh, like you're gonna stop?", "lineIndex": 38, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "C'mon..", "lineIndex": 39, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "C'mon..", "lineIndex": 40, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "You don't think I can?", "lineIndex": 41, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "No chance.", "lineIndex": 42, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "You think you could?", "direction": "daring", "lineIndex": 43, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Well, I know I could hold out longer than you.", "lineIndex": 44, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Care to make it interesting?", "lineIndex": 45, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Sure, how much?", "lineIndex": 46, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "A hundred dollars.", "lineIndex": 47, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "You're on.", "direction": "pointing", "lineIndex": 48, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_kramer", "lineText": "Wait a second, wait a second. Count me in on this.", "direction": "butting in; clicks his tongue", "lineIndex": 49, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "You?", "lineIndex": 50, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_kramer", "lineText": "Yeah.", "lineIndex": 51, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "You'll be out before we get the check.", "lineIndex": 52, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "I want to be in on this, too.", "direction": "smiling", "lineIndex": 53, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Ohh, no. No, no, no..", "direction": "rejecting", "lineIndex": 54, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Ohh, no. No, no, no..", "direction": "rejecting", "lineIndex": 55, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Why?", "lineIndex": 56, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "It's apples and oranges..", "direction": "showing difference", "lineIndex": 57, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "What? Why? Why?", "direction": "persistent", "lineIndex": 58, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Because you're a woman!", "lineIndex": 59, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "So what?", "lineIndex": 60, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "It's easier for a woman not to do it than a man.", "lineIndex": 61, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Oh.", "direction": "sarcastic", "lineIndex": 62, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "We have to do it. It's part of our lifestyle. It's like, uh.. shaving.", "lineIndex": 63, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Oh, that is such bologna. I shave my legs.", "lineIndex": 64, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_kramer", "lineText": "Not everyday.", "direction": "making a point", "lineIndex": 65, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Alright, look, you want to be in?", "lineIndex": 66, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Yeah!", "lineIndex": 67, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "You gotta give us odds. At least two to one - you gotta put up two-hundred dollars.", "lineIndex": 68, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_kramer", "lineText": "No, a thousand!", "lineIndex": 69, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "No, I'll - I'll put up one-fifty.", "lineIndex": 70, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Alright, you're in for one-fifty.", "lineIndex": 71, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Okay, one-fifty.", "direction": "nodding", "lineIndex": 72, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Alright, now, how are we gonna monitor this thing?", "lineIndex": 73, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Well, obviously, we all know each other very well, I'm sure that we'll all feel comfortable within the confines of the honor system.", "lineIndex": 74, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_kramer", "lineText": "Alright.", "lineIndex": 75, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Yeah!", "lineIndex": 76, "scrollMode": "auto" }
  ]
}
