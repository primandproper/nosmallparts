{
  "title": "Seinfeld - The Soup Nazi (Excerpt)",
  "description": "Soup Nazi scene from Seinfeld (1995), created by Larry David and Jerry Seinfeld",
  "author": "Larry David, Jerry Seinfeld",
  "isPublic": true,
  "castMembers": [
    { "id": "seinfeld_elaine", "name": "Elaine", "sortOrder": 0 },
    { "id": "seinfeld_jerry", "name": "Jerry", "sortOrder": 1 },
    { "id": "seinfeld_george", "name": "George", "sortOrder": 2 },
    { "id": "seinfeld_furnitureguy", "name": "Furniture Guy", "sortOrder": 3 },
    { "id": "seinfeld_bania", "name": "Bania", "sortOrder": 4 },
    { "id": "seinfeld_soupnazi", "name": "Soup Nazi", "sortOrder": 5 }
  ],
  "lines": [
    { "castMemberId": "seinfeld_elaine", "lineText": "Boy, I'm in the mood for a cheeseburger.", "lineIndex": 0, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "No. We gotta go to the soup place.", "lineIndex": 1, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "What soup place?", "lineIndex": 2, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Oh, there's a soup stand, Kramer's been going there.", "lineIndex": 3, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "He's always raving. I finally got a chance to go there the other day, and I tell you this, you will be stunned.", "lineIndex": 4, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Stunned by soup?", "lineIndex": 5, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "You can't eat this soup standing up, your knees buckle.", "lineIndex": 6, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Huh. All right. Come on.", "lineIndex": 7, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "There's only one caveat -- the guy who runs the place is a little temperamental, especially about the ordering procedure. He's secretly referred to as the Soup Nazi.", "lineIndex": 8, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Why? What happens if you don't order right?", "lineIndex": 9, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "He yells and you don't get your soup.", "lineIndex": 10, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "What?", "lineIndex": 11, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Just follow the ordering procedure and you will be fine.", "lineIndex": 12, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "All right. All right. Let's - let's go over that again.", "lineIndex": 13, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "All right. As you walk in the place move immediately to your right.", "lineIndex": 14, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "What?", "lineIndex": 15, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "The main thing is to keep the line moving.", "lineIndex": 16, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "All right. So, you hold out your money, speak your soup in a loud, clear voice, step to the left and receive.", "lineIndex": 17, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Right. It's very important not to embellish on your order. No extraneous comments. No questions. No compliments.", "lineIndex": 18, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Oh, boy, I'm really scared!", "lineIndex": 19, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Elaine.", "lineIndex": 20, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "All right. Jerry, that's enough now about the Soup Nazi. Whoa! Wow! Look at this. You know what this is? This is an antique armoire. Wow! It's French. Armoire.", "lineIndex": 21, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Ar-moire.", "lineIndex": 22, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "How much is this?", "lineIndex": 23, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_furnitureguy", "lineText": "I was asking 250, but you got a nice face. 2 even.", "lineIndex": 24, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Huh? Ha. 200. You know, I've always wanted one of these things.", "lineIndex": 25, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "He gave you the nice face discount.", "lineIndex": 26, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "Yeah. All right. You guys go ahead.", "lineIndex": 27, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "What about the soup?", "lineIndex": 28, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_elaine", "lineText": "I'm getting an armoire, Jerry.", "lineIndex": 29, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Pardon.", "direction": "in French accent", "lineIndex": 30, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "This line is huge.", "lineIndex": 31, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "It's like this all the time.", "lineIndex": 32, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Isn't that that Bania guy?", "lineIndex": 33, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Oh, no. It is. Just be still.", "lineIndex": 34, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Whoop! Too late. I think he picked up the scent.", "lineIndex": 35, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_bania", "lineText": "Hey, Jerry! I didn't know you liked soup.", "lineIndex": 36, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Hard to believe.", "lineIndex": 37, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_bania", "lineText": "This guy makes the best soup in the city, Jerry. The best. You know what they call him? Soup Nazi.", "lineIndex": 38, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Shhhhh! All right, Bania, I - I'm not letting you cut in line.", "lineIndex": 39, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_bania", "lineText": "Why not?", "lineIndex": 40, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Because if he catches us, we'll never be able to get soup again.", "lineIndex": 41, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_bania", "lineText": "Okay. Okay.", "lineIndex": 42, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Medium turkey chili.", "lineIndex": 43, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Medium crab bisque.", "lineIndex": 44, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "I didn't get any bread.", "lineIndex": 45, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_jerry", "lineText": "Just forget it. Let it go.", "lineIndex": 46, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Um, excuse me, I - I think you forgot my bread.", "lineIndex": 47, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_soupnazi", "lineText": "Bread -- $2 extra.", "lineIndex": 48, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "$2? But everyone in front of me got free bread.", "lineIndex": 49, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_soupnazi", "lineText": "You want bread?", "lineIndex": 50, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "Yes, please.", "lineIndex": 51, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_soupnazi", "lineText": "$3!", "lineIndex": 52, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_george", "lineText": "What?", "lineIndex": 53, "scrollMode": "auto" },
    { "castMemberId": "seinfeld_soupnazi", "lineText": "No soup for you!", "direction": "snaps fingers", "lineIndex": 54, "scrollMode": "auto" }
  ]
}
